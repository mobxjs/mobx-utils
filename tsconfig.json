{
    "version": "1.8.10",
    "compilerOptions": {
        "target": "es2015",
        "module": "node16",
        "moduleResolution": "node16",
        "noEmit": true,
        "rootDir": ".",
        "lib": ["dom", "es2015", "scripthost", "es2018.asyncgenerator", "esnext.collection"],
        "useDefineForClassFields": true,
        "strict": false,
        "strictNullChecks": true,
        "types": ["jest", "node"],
    },
    "include": ["**/*.ts"],
    "exclude": ["/node_modules"]
}
